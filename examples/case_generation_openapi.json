{
  "openapi": "3.1.0",
  "info": {
    "title": "Offline case generation example",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "summary": "List users (offline example)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {"type": "integer"}
          }
        ],
        "responses": {"200": {"description": "Example list response"}}
      },
      "post": {
        "summary": "Create user (offline example)",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {"name": {"type": "string"}}
              }
            }
          }
        },
        "responses": {"201": {"description": "Example creation response"}}
      }
    },
    "/users/{user_id}": {
      "parameters": [
        {
          "name": "user_id",
          "in": "path",
          "required": true,
          "schema": {"type": "integer"}
        }
      ],
      "get": {
        "summary": "Get user (needs user_id)",
        "responses": {"200": {"description": "Example user response"}}
      }
    }
  }
}
